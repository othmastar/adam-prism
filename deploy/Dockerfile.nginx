# ═══════════════════════════════════════════
# Dockerfile - Adam Prism Nginx
# مع entrypoint ديناميكي لـ HTTPS
# ═══════════════════════════════════════════

FROM nginx:alpine

LABEL org.opencontainers.image.title="Adam Prism Nginx"
LABEL org.opencontainers.image.description="Reverse Proxy مع دعم HTTPS ديناميكي"
LABEL org.opencontainers.image.version="2.0.0"

# Copy nginx config (من deploy/ لأن context = project root)
COPY deploy/nginx.conf /etc/nginx/nginx.conf

# Copy entrypoint script
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy SSL generation script (for manual use)
COPY deploy/generate_ssl.sh /generate_ssl.sh
RUN chmod +x /generate_ssl.sh

# Create SSL directory
RUN mkdir -p /etc/nginx/ssl

# Allow domain override via env
ENV DOMAIN=adam-prism.online

EXPOSE 80 443

ENTRYPOINT ["/entrypoint.sh"]